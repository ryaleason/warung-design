# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Service Role Key: Ambil dari Supabase Dashboard -> Project Settings -> API Keys (secret)
# Jika belum memiliki service role key, biarkan kosong agar sistem otomatis menggunakan ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot (Verification & Notification)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Cron Job Auto-Expire Configuration (cron-job.org)
CRON_SECRET=

# Payment & QRIS
# URL to static GoPay Merchant QRIS image (can be Supabase Storage public URL or local asset)
NEXT_PUBLIC_QRIS_IMAGE_URL=/qris-gopay-placeholder.png

# Application URL (for generating download links & redirects)
NEXT_PUBLIC_APP_URL=https://www.warungdesign.web.id

# Email Delivery (Optional: Resend or Mock)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Warung Desain <noreply@warungdesain.com>"
